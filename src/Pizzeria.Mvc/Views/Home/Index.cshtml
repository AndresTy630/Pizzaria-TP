
@model IEnumerable<PizzaViewModel>
@using Pizzeria.Dominio.Entidades

@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Amore a prima pizza";
}

<!-- HERO -->
<section class="hero" id="inicio">

    <div class="hero-track" id="heroTrack">
        <div class="hero-slide" style="background-image: url('/images/hero-1.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero-2.jpg')"></div>
        <div class="hero-slide" style="background-image: url('/images/hero-3.jpg')"></div>

    </div>

    <div class="hero-content">
        <span>EL SABOR NOS UNE</span>

        <h1>
            AMAMOS<br />
            LA <strong>PIZZA.</strong>
        </h1>

        <p>
            Ingredientes frescos, recetas irresistibles
            y mucho amor en cada porción.
        </p>

        <a href="#menu" class="main-button">
            CONOCÉ NUESTRO MENÚ
        </a>

    </div>

</section>


<!-- FRANJA -->
<section class="red-strip">
    <h2>BUEN SABOR · BUENOS MOMENTOS · AMAMOS LA PIZZA</h2>
</section>


<!-- MENÚ -->
<section class="menu-section" id="menu">

    <div class="section-title">
        <span>ALGUNAS DE NUESTRAS ESPECIALIDADES</span>
        <h2>LA PIZZA ES <strong>PROTAGONISTA.</strong></h2>
        <p>Una pequeña muestra de lo que te espera. Cada visita, una selección distinta.</p>
    </div>

    @if (!Model.Any())
    {
        <p class="text-center">Por ahora no hay pizzas disponibles.</p>
    }
    else
    {
        <div class="pizza-grid">

            @foreach (var pizza in Model)
            {
                <article class="pizza-card">

                    <img src="@Url.Content("~/img/pizzas/pizza-" + pizza.IdPizza + ".jpg")"
                         alt="@pizza.Nombre" />

                    <div class="pizza-info">
                        <h3>@pizza.Nombre</h3>
                        <p>@pizza.Descripcion</p>
                        <strong>$@pizza.Precio.ToString("N2")</strong>
                    </div>

                </article>
            }

        </div>
    }

</section>


<!-- NOSOTROS -->
<section class="about-section" id="nosotros">

    <div class="about-image">
        <img src="~/images/nosotros.jpg" alt="Preparación de nuestras pizzas" />
    </div>

    <div class="about-content">

        <span>NUESTRA ESENCIA</span>

        <h2>
            UNA PASIÓN<br />
            POR LA <strong>PIZZA.</strong>
        </h2>

        <p>
            Para nosotros, una pizza es mucho más que una comida.
            Es compartir con amigos, disfrutar en familia y crear
            buenos momentos alrededor de la mesa.
        </p>

    </div>

</section>
