@model LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Iniciar sesión";
}

<h2 class="text-center mb-4">Iniciar sesión</h2>

<form asp-action="Login" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="form-floating mb-3">
        <input asp-for="Login" class="form-control" placeholder="Usuario o email" autocomplete="username" />
        <label asp-for="Login"></label>
        <span asp-validation-for="Login" class="text-danger small"></span>
    </div>

    <div class="form-floating mb-3">
        <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="current-password" />
        <label asp-for="Password"></label>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-danger w-100 py-2">Ingresar</button>
</form>

<p class="text-center mt-4 mb-0">
    ¿No tenés una cuenta?
    <a asp-controller="Registro" asp-action="Index">Registrate</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}