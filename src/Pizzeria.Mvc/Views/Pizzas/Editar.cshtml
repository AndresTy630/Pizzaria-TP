@model PizzaEditViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Editar pizza";
}

<h2 class="fw-bold mb-4">Editar pizza</h2>

<div class="card shadow-sm border-0" style="max-width: 600px;">
    <div class="card-body">
        <form asp-action="Editar" method="post">
            <input type="hidden" asp-for="IdPizza" />

            <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="Nombre" class="form-label"></label>
                <input asp-for="Nombre" class="form-control" />
                <span asp-validation-for="Nombre" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Descripcion" class="form-label"></label>
                <textarea asp-for="Descripcion" class="form-control" rows="3"></textarea>
                <span asp-validation-for="Descripcion" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Precio" class="form-label"></label>
                <input asp-for="Precio" class="form-control" type="number" step="0.01" />
                <span asp-validation-for="Precio" class="text-danger small"></span>
            </div>

            <button type="submit" class="btn btn-danger">Guardar</button>
            <a asp-action="Gestion" class="btn btn-outline-secondary">Cancelar</a>
        </form>
    </div>
</div>