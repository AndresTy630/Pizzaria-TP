@model IEnumerable<PizzaGestionViewModel>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Gestionar pizzas";
}

<h2 class="fw-bold mb-4">Gestionar pizzas</h2>

@if (TempData["Error"] is string error)
{
    <div class="alert alert-danger">@error</div>
}

<div class="table-responsive">
    <table class="table table-hover align-middle bg-white shadow-sm">
        <thead class="table-light">
            <tr>
                <th>Nombre</th>
                <th>Descripción</th>
                <th class="text-end">Precio</th>
                <th class="text-center">Estado</th>
                <th class="text-end">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var pizza in Model)
            {
                <tr>
                    <td class="fw-bold">@pizza.Nombre</td>
                    <td class="text-muted">@pizza.Descripcion</td>
                    <td class="text-end">$@pizza.Precio.ToString("N2")</td>
                    <td class="text-center">
                        @if (pizza.Disponible)
                        {
                            <span class="badge text-bg-success">Disponible</span>
                        }
                        else
                        {
                            <span class="badge text-bg-secondary">Agotada</span>
                        }
                    </td>
                    <td class="text-end text-nowrap">
                        <a asp-action="Editar" asp-route-id="@pizza.IdPizza"
                           class="btn btn-sm btn-outline-primary">Editar</a>

                        <a asp-action="Ofertas" asp-route-id="@pizza.IdPizza"
                           class="btn btn-sm btn-outline-danger">Ofertas</a>

                        <form asp-action="CambiarDisponibilidad" asp-route-id="@pizza.IdPizza"
                              method="post" class="d-inline">
                            <button type="submit" class="btn btn-sm btn-outline-secondary">
                                @(pizza.Disponible ? "Marcar agotada" : "Marcar disponible")
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>