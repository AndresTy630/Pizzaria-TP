@model MenuViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Menú";
}

<h2 class="fw-bold mb-4">Nuestro menú</h2>

<!-- BUSCADOR Y FILTROS -->
<form method="get" class="row g-2 align-items-center mb-4">
    <div class="col-12 col-md-5">
        <input type="search" name="buscar" value="@Model.Buscar"
               class="form-control" placeholder="Buscar pizza por nombre..." />
    </div>

    <div class="col-6 col-md-3">
        <select name="orden" class="form-select" onchange="this.form.submit()">
            <option value="nombre" selected="@(Model.Orden == "nombre")">Orden alfabético</option>
            <option value="precio_asc" selected="@(Model.Orden == "precio_asc")">Más barata primero</option>
            <option value="precio_desc" selected="@(Model.Orden == "precio_desc")">Más cara primero</option>
        </select>
    </div>

    <div class="col-12 col-md-2 d-flex gap-2">
        <button type="submit" class="btn btn-danger flex-fill">Buscar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

@if (!Model.Pizzas.Any())
{
    <div class="alert alert-info">No se encontraron pizzas con esos filtros.</div>
}

<div class="row row-cols-1 row-cols-md-2 row-cols-xl-3 g-4">
    @foreach (var pizza in Model.Pizzas)
    {
        <div class="col">
            <div class="card h-100 shadow-sm border-0">

                <div class="card-body d-flex flex-column">
                    <h3 class="h5 fw-bold pe-5">@pizza.Nombre</h3>
                    <p class="card-text text-muted">@pizza.Descripcion</p>
                </div>
            </div>
        </div>
    }
</div>