@model OfertasViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Ofertas";
}

<a asp-action="Gestion" class="link-secondary">← Volver a la lista</a>
<h2 class="fw-bold mt-2">Ofertas de @Model.Nombre</h2>
<p class="text-muted">Precio actual: $@Model.Precio.ToString("N2")</p>

<div class="row g-4">

    <!-- NUEVA OFERTA -->
    <div class="col-lg-5">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h3 class="h5 fw-bold mb-3">Nueva oferta</h3>

                <form asp-action="CrearOferta" asp-route-id="@Model.IdPizza" method="post">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="mb-3">
                        <label asp-for="Nueva.Titulo" class="form-label">Título</label>
                        <input asp-for="Nueva.Titulo" class="form-control" />
                        <span asp-validation-for="Nueva.Titulo" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nueva.Tipo" class="form-label">Tipo de descuento</label>
                        <select asp-for="Nueva.Tipo" id="tipo" class="form-select">
                            <option value="1">Porcentaje (%)</option>
                            <option value="2">Monto fijo por pizza ($)</option>
                        </select>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nueva.Valor" id="labelValor" class="form-label">Porcentaje (%)</label>
                        <input asp-for="Nueva.Valor" class="form-control" type="number" step="0.01" />
                        <span asp-validation-for="Nueva.Valor" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nueva.CantidadMinima" class="form-label">Cantidad mínima de pizzas</label>
                        <input asp-for="Nueva.CantidadMinima" class="form-control" type="number" min="1" />
                        <span asp-validation-for="Nueva.CantidadMinima" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nueva.FechaInicio" class="form-label">Desde</label>
                        <input asp-for="Nueva.FechaInicio" class="form-control" type="datetime-local" />
                    </div>

                    <div class="mb-3">
                        <label asp-for="Nueva.FechaFin" class="form-label">Hasta</label>
                        <input asp-for="Nueva.FechaFin" class="form-control" type="datetime-local" />
                    </div>

                    <button type="submit" class="btn btn-danger w-100">Crear oferta</button>
                </form>
            </div>
        </div>
    </div>

    <!-- HISTORIAL -->
    <div class="col-lg-7">
        <div class="card shadow-sm border-0">
            <div class="card-body">
                <h3 class="h5 fw-bold mb-3">Historial de ofertas</h3>

                @if (!Model.Promociones.Any())
                {
                    <div class="alert alert-info mb-0">Esta pizza todavía no tuvo ofertas.</div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table align-middle">
                            <thead class="table-light">
                                <tr>
                                    <th>Oferta</th>
                                    <th>Vigencia</th>
                                    <th>Estado</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in Model.Promociones)
                                {
                                    <tr>
                                        <td>
                                            <div class="fw-bold">@p.Titulo</div>
                                            <div class="small text-muted">@p.Descripcion</div>
                                        </td>
                                        <td class="small">
                                            @p.FechaInicio.ToString("dd/MM/yyyy HH:mm")<br />
                                            @p.FechaFin.ToString("dd/MM/yyyy HH:mm")
                                        </td>
                                        <td>
                                            @{
                                                var color = p.Estado switch
                                                {
                                                    "Vigente" => "success",
                                                    "Programada" => "info",
                                                    _ => "secondary"
                                                };
                                            }
                                            <span class="badge text-bg-@color">@p.Estado</span>
                                        </td>
                                        <td class="text-end">
                                            @if (p.PuedeDesactivar)
                                            {
                                                <form asp-action="DesactivarOferta" asp-route-id="@Model.IdPizza"
                                                      asp-route-idPromocion="@p.IdPromocion" method="post">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">Desactivar</button>
                                                </form>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        const tipo = document.getElementById('tipo');
        const label = document.getElementById('labelValor');
        function actualizarLabel() {
            label.textContent = tipo.value === '1' ? 'Porcentaje (%)' : 'Monto por pizza ($)';
        }
        tipo.addEventListener('change', actualizarLabel);
        actualizarLabel();
    </script>
}