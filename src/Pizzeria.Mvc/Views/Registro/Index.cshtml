@model RegistroViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Registrarse";
}

<h2 class="text-center mb-4">Crear cuenta</h2>

<form asp-action="Registro" method="post">

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="row g-3">

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Usuario" class="form-control" placeholder="Usuario" autocomplete="username" />
                <label asp-for="Usuario"></label>
            </div>
            <span asp-validation-for="Usuario" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Email" class="form-control" placeholder="Email" autocomplete="email" />
                <label asp-for="Email"></label>
            </div>
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Nombre" class="form-control" placeholder="Nombre" />
                <label asp-for="Nombre"></label>
            </div>
            <span asp-validation-for="Nombre" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Apellido" class="form-control" placeholder="Apellido" />
                <label asp-for="Apellido"></label>
            </div>
            <span asp-validation-for="Apellido" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Password" class="form-control" placeholder="Contraseña" autocomplete="new-password" />
                <label asp-for="Password"></label>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="ConfirmarPassword" class="form-control" placeholder="Repetir contraseña" autocomplete="new-password" />
                <label asp-for="ConfirmarPassword"></label>
            </div>
            <span asp-validation-for="ConfirmarPassword" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Telefono" class="form-control" placeholder="Teléfono" autocomplete="tel" />
                <label asp-for="Telefono"></label>
            </div>
            <span asp-validation-for="Telefono" class="text-danger small"></span>
        </div>

        <div class="col-md-6">
            <div class="form-floating">
                <input asp-for="Direccion" class="form-control" placeholder="Dirección" autocomplete="street-address" />
                <label asp-for="Direccion"></label>
            </div>
            <span asp-validation-for="Direccion" class="text-danger small"></span>
        </div>

    </div>

    <button type="submit" class="btn btn-danger w-100 py-2 mt-4">Crear cuenta</button>
</form>

<p class="text-center mt-4 mb-0">
    ¿Ya tenés una cuenta?
    <a asp-controller="Login" asp-action="Index">Iniciar sesión</a>
</p>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}