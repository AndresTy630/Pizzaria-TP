@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5 text-center">
    <h1 class="display-4 text-danger">Ups 🍕</h1>
    <p class="lead">Ocurrió un error inesperado. Probá de nuevo en unos minutos.</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Código de error: <code>@Model.RequestId</code></p>
    }

    <a asp-controller="Landing" asp-action="Landing" class="btn btn-danger">Volver al inicio</a>
</div>