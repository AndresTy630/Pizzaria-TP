<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizza Massa Club</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-warning-subtle">

    <div class="container min-vh-100 d-flex align-items-center py-4">
        <div class="row justify-content-center w-100">
            <div class="col-12 col-md-8 col-lg-6">

                <div class="text-center mb-4">
                    <a asp-controller="Landing" asp-action="Landing"
                       class="h2 fw-bold text-danger text-decoration-none">🍕 Pizza Massa Club</a>
                </div>

                @if (TempData["Exito"] is string exito)
                {
                    <div class="alert alert-success">@exito</div>
                }

                <div class="card shadow border-0">
                    <div class="card-body p-4">
                        @RenderBody()
                    </div>
                </div>

                <p class="text-center mt-3">
                    <a asp-controller="Landing" asp-action="Landing" class="link-secondary">← Volver al inicio</a>
                </p>

            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>