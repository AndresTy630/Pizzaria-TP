<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Pizza Massa Club</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet" />
</head>
<body class="bg-body-tertiary">

    <div class="row g-0 min-vh-100">

        <aside class="col-md-3 col-lg-2 bg-dark text-white p-3">
            <a asp-controller="Landing" asp-action="Landing"
               class="h5 text-white text-decoration-none">🍕 Massa Club</a>

            <ul class="nav flex-column mt-4">
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Dashboard" asp-action="Index">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link text-white" asp-controller="Landing" asp-action="Landing">Sitio web</a>
                </li>
            </ul>

            <hr />

            <a asp-controller="Landing" asp-action="Landing"
               class="btn btn-outline-light btn-sm w-100">Cerrar sesión</a>
        </aside>

        <main class="col-md-9 col-lg-10 p-4">
            @RenderBody()
        </main>

    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>