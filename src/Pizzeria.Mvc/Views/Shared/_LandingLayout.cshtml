
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Amore a prima pizza</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/landing.css" asp-append-version="true" />
</head>

<body class="@ViewData["BodyClass"]">

    <nav class="navbar-landing">
        <div class="nav-container">

            <a asp-controller="Home" asp-action="Index">
                <img src="~/images/logo.png" alt="Amore a prima pizza" class="logo">
            </a>

            <button class="menu-toggle" id="menuToggle">
                <i class="bi bi-list"></i>
            </button>

            <div class="nav-links" id="navLinks">
                <a asp-controller="Home" asp-action="Index" asp-fragment="inicio">INICIO</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="menu">PRODUCTOS</a>
                <a asp-controller="Sucursales" asp-action="Index">SUCURSALES</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="nosotros">NOSOTROS</a>
                <a asp-controller="Home" asp-action="Index" asp-fragment="contacto">CONTACTO</a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a asp-controller="Dashboard" asp-action="Index" class="login-link">MI PANEL</a>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="login-link">INGRESAR</a>
                }
            </div>

        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <!-- FOOTER -->
    <footer id="contacto">

        <div class="footer-content">

            <div>
                <h2>AMAMOS LA PIZZA</h2>
                <p>Una pasión que se comparte en cada porción.</p>
            </div>

            <div class="social-links">
                <a href="#" aria-label="Instagram"><i class="bi bi-instagram"></i></a>
                <a href="#" aria-label="Facebook"><i class="bi bi-facebook"></i></a>
                <a href="#" aria-label="TikTok"><i class="bi bi-tiktok"></i></a>
            </div>

        </div>

        <div class="footer-bottom">
            © 2026 Miseal Piuca y Andrés Torrico.
        </div>

    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/landing.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
