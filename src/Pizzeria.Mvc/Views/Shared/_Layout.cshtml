<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Pizzería</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/Views/Shared/_Layout.cshtml.css" />
</head>

<body>

    <!-- NAVBAR -->
    <nav class="navbar navbar-expand-md navbar-dark bg-danger sticky-top">

        <div class="container-fluid px-4">

            <!-- Botón celular -->
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuNavbar">

                <span class="navbar-toggler-icon"></span>

            </button>

            <!-- Botones -->
            <div class="collapse navbar-collapse justify-content-end" id="menuNavbar">

                <div class="d-flex flex-column flex-md-row gap-2">

                    <a class="btn btn-danger text-white" href="/#contacto">
                        Contacto
                    </a>

                    <a class="btn btn-danger text-white" href="/#menu">
                        Menú
                    </a>

                    <a class="btn btn-warning" href="/#">
                        Registrarse
                    </a>

                    <a class="btn btn-warning" href="/#">
                        Iniciar sesión
                    </a>

                </div>

            </div>

        </div>

    </nav>


    <!-- CONTENIDO DE LA PÁGINA -->
    <main>
        @RenderBody()
    </main>


    <!-- FOOTER -->
    <footer class="bg-dark text-white text-center py-3">
        <p class="mb-0">
            © 2026 Misael Piuca y Andres Torrico
        </p>
    </footer>


    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>

</html>