<!DOCTYPE html>

<html lang="es">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

<title>@ViewData["Title"] - Pizzería</title>

<!-- Bootstrap -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet">

<!-- CSS del Layout -->
<link rel="stylesheet" href="~/Views/Shared/_Layout.cshtml.css" />

</head>

<body>

<!-- NAVBAR -->
<nav class="navbar navbar-dark bg-danger sticky-top">
    <div class="container-fluid px-4">

        <a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">
            🍕 Pizzería
        </a>

        <div class="d-flex gap-2">

            <a class="btn btn-danger text-white" href="/#menu">
                Menú
            </a>

            <a class="btn btn-danger text-white" href="/#contacto">
                Contacto
            </a>

            <a class="btn btn-danger text-white" href="#">
                Pedidos
            </a>

            <a class="btn btn-warning" href="/#menu">
                Pedir ahora
            </a>

        </div>

    </div>
</nav>


<!-- CONTENIDO DE CADA VISTA -->
<main>
    @RenderBody()
</main>


<!-- FOOTER -->
<footer class="bg-dark text-white text-center py-3">

    <p class="mb-0">
        © 2026 Misael Piuca y Andres Torrico
    </p>

</footer>


@await RenderSectionAsync("Scripts", required: false)

</body>

</html>
