@model IEnumerable<Sucursal>

@{
    var logueado = User.Identity?.IsAuthenticated == true;
    Layout = logueado ? "_DashboardLayout" : "_LandingLayout";
    ViewData["Title"] = "Sucursales";
    ViewData["BodyClass"] = "interna";
    var lista = Model.ToList();
}

<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css" />

<style>
    .suc-page { padding: @(logueado ? "0" : "110px 4% 40px"); }
    .suc-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:20px; flex-wrap:wrap; gap:10px; }
    .suc-head h1 { font-family:"Oswald",sans-serif; font-weight:900; text-transform:uppercase; margin:0; }
    .suc-head h1 span { color:#d5092f; }
    .btn-suc-add { background:#d5092f; color:#fff; padding:10px 18px; font-weight:700; border-radius:4px; text-decoration:none; }
    .btn-suc-add:hover { background:#a80725; color:#fff; }

    .suc-layout { display:grid; grid-template-columns:1fr 380px; height:75vh; min-height:520px; box-shadow:0 4px 20px rgba(0,0,0,.1); background:#fff; }
    #mapa { height:100%; width:100%; z-index:0; }
    .suc-lista { overflow-y:auto; padding:10px 24px; }
    .suc-item { padding:16px 8px; border-bottom:1px solid #eee; cursor:pointer; transition:.15s; }
    .suc-item:hover, .suc-item.activa { background:#fff5f5; }
    .suc-item h3 { color:#d5092f; font-family:"Oswald",sans-serif; font-size:18px; margin:0 0 6px; text-transform:uppercase; }
    .suc-item p { margin:0; font-size:15px; }

    .pin { width:34px; height:34px; background:#d5092f; border:3px solid #fff; border-radius:50% 50% 50% 0;
           transform:rotate(-45deg); display:flex; align-items:center; justify-content:center; box-shadow:0 2px 6px rgba(0,0,0,.4); }
    .pin i { transform:rotate(45deg); color:#fff; font-size:14px; }

    @@media (max-width: 900px) {
        .suc-layout { grid-template-columns:1fr; height:auto; }
        #mapa { height:340px; }
        .suc-lista { max-height:420px; }
    }
</style>

<div class="suc-page">
    <div class="suc-head">
        <h1>Nuestras <span>sucursales</span></h1>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Crear" class="btn-suc-add"><i class="bi bi-plus-lg"></i> Agregar sucursal</a>
        }
    </div>

    <div class="suc-layout">
        <div id="mapa"></div>

        <div class="suc-lista">
            @if (!lista.Any())
            {
                <p class="text-muted mt-3">No hay sucursales cargadas.</p>
            }
            @foreach (var s in lista)
            {
                <div class="suc-item" data-id="@s.IdSucursal">
                    <h3>@s.Direccion</h3>
                    @if (!string.IsNullOrWhiteSpace(s.Telefono))
                    {
                        <p><i class="bi bi-telephone me-1"></i>@s.Telefono</p>
                    }
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
    <script>
        const sucs = @Json.Serialize(lista.Select(s => new { s.IdSucursal, s.Direccion, s.Telefono, s.Latitud, s.Longitud }));
        const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));

        const map = L.map('mapa').setView([-34.6037, -58.4], 11);
        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            maxZoom: 19, attribution: '© OpenStreetMap'
        }).addTo(map);

        const icono = L.divIcon({
            className: '', html: '<div class="pin"><i class="bi bi-fire"></i></div>',
            iconSize: [34, 34], iconAnchor: [17, 34], popupAnchor: [0, -34]
        });

        const marcadores = {}, puntos = [];

        function marcar(id) {
            document.querySelectorAll('.suc-item').forEach(x => x.classList.toggle('activa', x.dataset.id == id));
        }

        sucs.forEach(s => {
            if (s.latitud == null || s.longitud == null) return;
            const m = L.marker([s.latitud, s.longitud], { icon: icono }).addTo(map)
                .bindPopup(`<strong>${esc(s.direccion)}</strong>${s.telefono ? '<br>' + esc(s.telefono) : ''}`);
            m.on('click', () => marcar(s.idSucursal));
            marcadores[s.idSucursal] = m;
            puntos.push([s.latitud, s.longitud]);
        });

        if (puntos.length) map.fitBounds(puntos, { padding: [40, 40], maxZoom: 15 });

        document.querySelectorAll('.suc-item').forEach(el => el.addEventListener('click', () => {
            const m = marcadores[el.dataset.id];
            marcar(el.dataset.id);
            if (m) { map.flyTo(m.getLatLng(), 16); m.openPopup(); }
        }));
    </script>
}